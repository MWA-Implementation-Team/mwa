{
    "name": "mwa",
    "version": "0.1.0",
    "type": "module",
    "imports": {
        "#src/*": "./dist/*"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/main.js",
        "dev": "node dev.js",
        "seed": "npm run build && node dist/seed.js",
        "tsc-watch": "tsc --watch --preserveWatchOutput",
        "format": "prettier --write .",
        "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && prettier --check --log-level error ."
    },
    "devDependencies": {
        "@types/node": "^22.20.3",
        "prettier": "^3.9.8",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "hono": "^4.13.8",
        "preact": "^10.29.8",
        "preact-render-to-string": "^6.7.0"
    }
}
